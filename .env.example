# Copy to .env and fill in. Your real .env is git-ignored.
# Used by the Vite client at build time (preview + deployment).

# Public URL of the deployed backend (https://npat-arena-server.onrender.com in production).
VITE_API_URL=

# Optional: raw Socket.IO endpoint when VITE_API_URL is a page/proxy that is not the socket root.
# Falls back to VITE_API_URL when unset.
VITE_SOCKET_URL=